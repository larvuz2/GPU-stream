#
# Run by the Selkies window manager once it is up, as the session's
# application, installed as /etc/xdg/openbox/autostart, which both backends
# read: Blender, started in the workspace so its file dialogs open on the
# directory that outlives the Sandbox.
cd "${SELKIES_MODAL_WORKSPACE:-${HOME}}" 2> /dev/null || true
exec blender
