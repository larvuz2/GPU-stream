#
# Run by the Selkies window manager once it is up, as the session's
# application, installed as /etc/xdg/openbox/autostart, which both backends
# read: PhotoCraft, in the session's project folder (`craft/project.sh`), the
# one a FilmCraft engine of the same project opens in.
#
# PhotoCraft's settings (PHOTOCRAFT_CONFIG_DIR) and the recovery copies of
# unsaved documents it keeps under XDG_STATE_HOME are in `.photocraft` in the
# project folder, where they outlive the Sandbox and stay with their project.
#
# Settings made here for the first time start PhotoCraft in its CPU
# compatibility rendering mode. A Sandbox has no hardware adapter that can
# present into the display (no render node; NVIDIA's Vulkan refuses it), so the
# window is a software one on every machine, and PhotoCraft then composites on
# the CPU whatever mode it is in; in its automatic mode it says so in a notice
# over the window at every start, which this mode, the one that notice offers
# to keep, leaves out. A mode the user picks afterwards stays theirs.
#
# The control channel listens on the Sandbox's loopback only, on
# PHOTOCRAFT_CONTROL_PORT, for connections that authenticate with
# PHOTOCRAFT_CONTROL_TOKEN, which the launcher makes for each session
# (sandbox.py); what it may read and write is the project folder alone.
folder="$(selkies-modal-project)" || exit 1
mkdir -p "${folder}/.photocraft/state"
cd "${folder}" || exit 1
export PHOTOCRAFT_CONFIG_DIR="${folder}/.photocraft"
export XDG_STATE_HOME="${folder}/.photocraft/state"
[ -e "${PHOTOCRAFT_CONFIG_DIR}/preferences.json" ] ||
  printf '%s\n' '{"performance": {"renderingMode": "cpu"}}' > "${PHOTOCRAFT_CONFIG_DIR}/preferences.json"
exec photocraft --automation-read-root "${folder}" --automation-write-root "${folder}"
