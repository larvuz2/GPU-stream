  The Nuke session's window rules, read by the Selkies window manager over its
  defaults: the setup's own windows (setup.sh) open at their own size in the
  middle of the screen and above Firefox, where the rule for an application
  alone would have maximized them behind it.
-->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <applications>
    <application title="Set up Nuke">
      <maximized>no</maximized>
      <layer>above</layer>
      <position force="yes"><x>center</x><y>center</y></position>
    </application>
  </applications>
</openbox_config>
