#
# The Unreal view, as an s6 service of the session (/etc/service/unreal-view),
# beside the base image's own: s6 starts it with the session and restarts it
# whenever it exits, which is how the view changes hands (view.sh).
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-ubuntu}"
until [ -f "${XDG_RUNTIME_DIR}/container-env" ]; do sleep 0.5; done
# shellcheck disable=SC1091  # written by container-entrypoint.sh at startup
. "${XDG_RUNTIME_DIR}/container-env"
exec selkies-modal-unreal-view
