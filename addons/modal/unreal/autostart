#
# Run by the Selkies window manager once it is up, as the session's
# application, installed as /etc/xdg/openbox/autostart: the GitHub client
# (github.sh), which is where a developer starts, as they do on their own
# machine with GitHub Desktop.
#
# A session started for a project linked to a GitHub repository
# (MOODY_GIT_REPO) clones it in the background as the client opens (clone.py),
# with a progress line over the client saying how far it is, and then opens the
# clone in the client. Where the clone fails, a line says why and to clone by
# hand instead.
#
# Otherwise, while the clone folder has no Unreal project yet, one line over
# the client says what to do: sign in, then clone the game there.
#
# Each line waits for the client's window, so that it opens over it rather than
# under it, and draws in software (GSK_RENDERER), as the Nuke session's windows
# do. The rest of the desktop (Firefox, Blender, the files) is in the start menu
# and on the taskbar (desktop-config).
folder="$(selkies-modal-unreal-github --clone-folder)" || exit 1
selkies-modal-unreal-github > /dev/null 2>&1 &

client_window() {
  timeout 30 xdotool search --sync --onlyvisible --class desktop-plus > /dev/null 2>&1
}

if [ -n "${MOODY_GIT_REPO-}" ]; then
  (
    selkies-modal-unreal-clone 2> /dev/null | {
      client_window
      GSK_RENDERER=cairo zenity --progress --pulsate --auto-close --no-cancel --title "Cloning" \
        --text "Cloning ${MOODY_GIT_REPO}" > /dev/null 2>&1
    }
    status="$(selkies-modal-unreal-clone --status)"
    if [ "$(printf '%s' "${status}" | jq -r .state)" = "done" ]; then
      exec selkies-modal-unreal-github --cli-open="$(printf '%s' "${status}" | jq -r .path)" > /dev/null 2>&1
    fi
    GSK_RENDERER=cairo zenity --warning --no-markup --width 520 --title "Not cloned" \
      --text "${MOODY_GIT_REPO} could not be cloned: $(printf '%s' "${status}" | jq -r .detail)

Sign in to GitHub, then clone it here (File › Clone repository)." > /dev/null 2>&1
  ) &
elif [ -z "$(find "${folder}" -maxdepth 3 -name '*.uproject' -type f -print -quit 2> /dev/null)" ]; then
  client_window
  GSK_RENDERER=cairo zenity --info --no-wrap --title "Get started" --ok-label "Got it" \
    --text "<b>Sign in to GitHub, then clone your game here</b> (File › Clone repository)." > /dev/null 2>&1 &
fi
