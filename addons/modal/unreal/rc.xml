  The Unreal session's window rules, read by the Selkies window manager over its
  defaults: the line of instructions (autostart) opens at its own size in the
  middle of the screen and above the GitHub client it is about.
-->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <applications>
    <application title="Get started">
      <maximized>no</maximized>
      <layer>above</layer>
      <position force="yes"><x>center</x><y>center</y></position>
    </application>
  </applications>
</openbox_config>
